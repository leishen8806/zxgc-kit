{
  "name": "zxgc-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:showcase": "vite build",
    "typecheck": "tsc --noEmit",
    "test:contract": "node --test tests/tokens.test.mjs tests/ui-contract.test.mjs",
    "test:components": "vitest run",
    "test": "npm run test:contract && npm run test:components",
    "showcase": "vite --host 127.0.0.1",
    "check:public": "node scripts/check-public.mjs",
    "check": "npm run check:public && npm run build:tokens && npm run typecheck && npm test && npm run build:showcase"
  },
  "dependencies": {
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.65.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
